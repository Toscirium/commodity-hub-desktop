<RCC>
    <qresource prefix="/">
        <file>theme.qss</file>
        <file>fonts/DMSans.ttf</file>
        <file>fonts/SpaceGrotesk.ttf</file>
        <file>fonts/JetBrainsMono.ttf</file>
        <file>icons/app.png</file>
    </qresource>
    <qresource prefix="/tradingview">
        <file alias="chart.html">tradingview/chart.html</file>
        <file alias="lightweight-charts.js">tradingview/lightweight-charts.js</file>
    </qresource>
</RCC>
